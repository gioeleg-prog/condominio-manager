rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Condominio Manager — Firestore Security Rules
//
//  Modello dati (fase 2, REB-01): un documento per record sotto
//  buildings/{buildingId}/{collezione}/{id}. Le regole applicano a ogni
//  record ruolo (custom claim role), edificio (claim buildingId) e forma;
//  vedi match /buildings più sotto.
//
//  appdata/{key}: dati globali (categorie, edificio attivo, configurazione,
//  marchio, registro accessi) e, in sola lettura per il superAdmin, i
//  vecchi documenti JSON per edificio (copia della migrazione).
//
//  Le collezioni roles/ e auditEvents/ le scrivono solo le Cloud Functions
//  (Admin SDK, che non passa da queste regole). Tutto ciò che non è
//  elencato è negato.
// ═══════════════════════════════════════════════════════════════

function isSignedIn() {
  return request.auth != null;
}

function role() {
  return request.auth.token.role; // 'superAdmin' | 'adminEdificio' | 'editor' | 'member' | null
}

function isSuperAdmin() {
  return isSignedIn() && role() == 'superAdmin';
}

// Ruoli per edificio: 'adminEdificio' gestisce tutto il proprio edificio;
// 'editor' scrive solo i dati finanziari (spese/entrate/fornitori); 'member'
// è di sola lettura. Vedi canAdmin/canEdit più sotto.
function myBuildingId() {
  return request.auth.token.buildingId;
}

// ─── Modello per edificio (buildings/**) ──────────────────────────
function inBuilding(b) {
  return isSignedIn() && (isSuperAdmin() || myBuildingId() == b);
}
function canAdmin(b) {
  return isSuperAdmin() || (isSignedIn() && role() == 'adminEdificio' && myBuildingId() == b);
}
function canEdit(b) {
  return isSuperAdmin() || (isSignedIn() && role() in ['adminEdificio', 'editor'] && myBuildingId() == b);
}
function isText(v) {
  return v == null || v is string || v is number;
}
function isList(v) {
  return v == null || v is list;
}
// Identificativi (id dei record e riferimenti ad altri record): finiscono in
// attributi HTML senza escape (data-edit-spesa="${s.id}"…), quindi solo
// lettere, cifre, punto, trattino e trattino basso. Audit 2026-10-19: un id
// documento con virgolette e tag permetteva di eseguire codice nella sessione
// di chi apriva la pagina, superAdmin compreso.
function isId(v) {
  return v is int || v is float || (v is string && v.matches('[A-Za-z0-9_.-]{1,64}'));
}
function isRef(v) {
  return v == null || v == '' || isId(v);
}
// Un allegato (js/sezioni/allegati.js): id (numero o testo) senza apici né
// caratteri HTML, nome e tipo testuali. L'id finisce in attributi HTML: audit
// 2026-10-15, un id con un apice permetteva di iniettare codice nella pagina.
// Audit 2026-10-19: il file sta nello spazio allegati di un condominio
// (storagePath; che sia il proprio lo controllano le storage.rules alla
// lettura) oppure, per i vecchi allegati incorporati, è un indirizzo data: in
// base64 (data64). Un data64 "javascript:…" veniva eseguito dal visualizzatore.
// id, storagePath, data64 e mime in un'unica espressione regolare, separati da "<"
// (che nessuno dei tre può contenere; "null" = campo assente): ogni
// espressione in più per elemento conta per ciascun allegato.
// Audit 2026-10-24: anche il tipo (mime) è un elenco chiuso, lo stesso di
// storage.rules (allowedType) e di MIME_ALLEGATI in js/sezioni/allegati.js (le tre
// copie le tiene allineate un test di qa/unit.spec.js, DAT-009); niente SVG né
// HTML, che un visualizzatore potrebbe trattare come contenuto attivo.
// Vale per gli allegati nuovi o cambiati: in un record che esiste già, un allegato
// identico a uno salvato non si ricontrolla (validAllegatiAgg, CR-001).
function validAllegato(a) {
  // (a.mime non è controllato a parte: se non è un testo, la concatenazione dà
  // errore e la regola nega; ogni controllo in meno vale per ciascun allegato)
  return a.nome is string
    && (string(a.id) + '<' + string(a.get('storagePath', null)) + '<' + string(a.get('data64', null)) + '<' + a.mime).matches(
         "[^'\"<>&]{1,100}<(null|buildings/[A-Za-z0-9_.-]{1,64}/allegati/[^/<]{1,300})<(null|data:[A-Za-z0-9.+/-]{1,100}(;[A-Za-z0-9=._-]{1,40})*;base64,[A-Za-z0-9+/=]*)<(image/(png|jpe?g|gif|webp|heic|heif|bmp|tiff)|application/(pdf|octet-stream|msword|rtf|zip)|application/vnd\\.(ms-excel|ms-powerpoint|openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|oasis\\.opendocument\\.(text|spreadsheet|presentation|graphics))|text/(plain|csv))");
}
// Le regole non hanno cicli: si controllano uno per uno gli elementi, fino a
// 10 (MAX_ALLEGATI in js/sezioni/allegati.js); una lista più lunga è
// rifiutata. Erano 20, ma con i controlli del 2026-10-19 oltre i 12 allegati si
// supera il limite di 1000 espressioni per richiesta (nei dati reali nessuna
// scheda ne ha più di uno).
function validAllegati(l) {
  let n = l is list ? l.size() : 99;
  return l == null || (n <= 10
    && (n <= 0 || validAllegato(l[0])) && (n <= 1 || validAllegato(l[1]))
    && (n <= 2 || validAllegato(l[2])) && (n <= 3 || validAllegato(l[3]))
    && (n <= 4 || validAllegato(l[4])) && (n <= 5 || validAllegato(l[5]))
    && (n <= 6 || validAllegato(l[6])) && (n <= 7 || validAllegato(l[7]))
    && (n <= 8 || validAllegato(l[8])) && (n <= 9 || validAllegato(l[9])));
}
// Come validAllegati, ma per un record che esiste già (CR-001, REL-002): un allegato
// identico a uno già salvato nel record non si ricontrolla (un vecchio allegato con
// un tipo oggi fuori elenco, o un data64, non rende il record non più modificabile
// né cancellabile); solo gli allegati nuovi o cambiati passano dal controllo
// completo, tipo compreso. Il confronto è con tutta la lista precedente, non con la
// stessa posizione: togliere un allegato sposta gli altri e non li rende "nuovi".
function validAllegatiAgg(l) {
  let v = resource.data.get('allegati', null);
  let w = v is list ? v : [];
  let n = l is list ? l.size() : 99;
  return l == null || (n <= 10
    && (n <= 0 || l[0] in w || validAllegato(l[0])) && (n <= 1 || l[1] in w || validAllegato(l[1]))
    && (n <= 2 || l[2] in w || validAllegato(l[2])) && (n <= 3 || l[3] in w || validAllegato(l[3]))
    && (n <= 4 || l[4] in w || validAllegato(l[4])) && (n <= 5 || l[5] in w || validAllegato(l[5]))
    && (n <= 6 || l[6] in w || validAllegato(l[6])) && (n <= 7 || l[7] in w || validAllegato(l[7]))
    && (n <= 8 || l[8] in w || validAllegato(l[8])) && (n <= 9 || l[9] in w || validAllegato(l[9])));
}
// Colore di un condomino (campo color): finisce in style="…" (avatarStyle), dove
// un ";" aggiungerebbe altro CSS. Audit 2026-10-21: solo un esadecimale.
function isColor(v) {
  return v == null || (v is string && v.matches('#[0-9A-Fa-f]{3,8}'));
}
// Importi (importo, preventivo, consuntivo): vuoti, oppure maggiori di zero con punto e al massimo due
// decimali (come li salva la pagina; un numero si confronta come testo). Consolidato QA-CONS-020.
// Percorso rapido: una sola espressione regolare sui tre valori insieme (conta per il limite di 1000
// espressioni). Solo se non basta (aggiornamento di un record con un importo vecchio, zero o negativo)
// si controlla campo per campo, e un valore invariato non blocca altri salvataggi.
function importoOk(d, k) {
  let v = d.get(k, null);
  return v == null || v == '' || (resource != null && v == resource.data.get(k, null))
    || (v is number ? v > 0
        : v is string && v.matches('(0*[1-9][0-9]*([.][0-9]{1,2})?|0+[.](0[1-9]|[1-9][0-9]?))'));
}
function importiOk(d) {
  return (string(d.get('importo', '')) + '<' + string(d.get('preventivo', '')) + '<' + string(d.get('consuntivo', ''))).matches(
      '(0*[1-9][0-9]*([.][0-9]{1,2})?|0+[.](0[1-9]|[1-9][0-9]?))?<(0*[1-9][0-9]*([.][0-9]{1,2})?|0+[.](0[1-9]|[1-9][0-9]?))?<(0*[1-9][0-9]*([.][0-9]{1,2})?|0+[.](0[1-9]|[1-9][0-9]?))?')
    || (resource != null && importoOk(d, 'importo') && importoOk(d, 'preventivo') && importoOk(d, 'consuntivo'));
}
// Date di ingresso e uscita di un condomino (DAT-008): vuote oppure AAAA-MM-GG, come le scrive la
// pagina (campo data). Un valore diverso già salvato non blocca altri salvataggi se non cambia; che
// la data esista davvero lo verifica il server quando la usa (ingressoFuturo in functions/notifiche.js).
function dataOk(d, k) {
  let v = d.get(k, null);
  return v == null || v == '' || (v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
    || (resource != null && v == resource.data.get(k, null));
}
// Data di un record (campo data: spesa, entrata, avviso, verbale): vuota oppure AAAA-MM-GG, come la
// scrive la pagina. Audit 2026-10-30: la data di una spesa di serie finiva nella scheda senza escape
// (spese.js, renderBoxSerie) e permetteva di eseguire codice nella sessione di chi la apriva. Un valore
// diverso già salvato non blocca altri salvataggi se non cambia. Le date dentro storicoAggiornamenti non
// si controllano qui (le regole non hanno cicli): le protegge esc() in vita.js.
function dataRecordOk(d) {
  let v = d.get('data', null);
  return v == null || v == '' || (v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
    || (resource != null && v == resource.data.get('data', null));
}
// Testo di un messaggio WhatsApp in impostazioni/whatsapp.
function testoWa(v) {
  return v is string && v.size() <= 1000;
}
// Forma e firma di ogni record scritto dal client (vedi match /buildings).
function validRecord(b, docId) {
  let d = request.resource.data;
  return isId(d.id) && string(d.id) == docId
    && string(d.edificioId) == b
    && isRef(d.get('condominoId', null)) && isRef(d.get('fornitoreId', null))
    && isRef(d.get('ricGruppoId', null)) && isRef(d.get('tabellaMillesimi', null))
    && isRef(d.get('delibereRifId', null)) && isRef(d.get('verbaleRifId', null))
    && d._updatedBy == request.auth.uid
    && d._updatedAt == request.time
    && (resource == null
          ? d.get('_createdBy', null) == request.auth.uid && d.get('_createdAt', null) == request.time
          : d.get('_createdBy', null) == resource.data.get('_createdBy', null)
            && d.get('_createdAt', null) == resource.data.get('_createdAt', null))
    && d.get('_deleted', false) is bool
    // Cancellazione logica (audit 2026-10-24): chi cancella firma _deletedBy; su un
    // record già cancellato _deletedBy non si cambia più, e un record non
    // cancellato non ne porta uno nuovo (il registro modifiche non si falsifica).
    // SEC-020: nemmeno una firma vecchia, rimasta dopo un ripristino, vale per una
    // cancellazione nuova: a ogni passaggio da attivo a cancellato _deletedBy è
    // chi scrive (se è la stessa persona di prima, il valore coincide).
    && (d.get('_deleted', false) == true
          ? d.get('_deletedBy', null) != null
            && (resource != null && resource.data.get('_deleted', false) == true
                  ? d.get('_deletedBy', null) == resource.data.get('_deletedBy', null)
                  : d.get('_deletedBy', null) == request.auth.uid)
          : d.get('_deletedBy', null) == null
            || (resource != null && d.get('_deletedBy', null) == resource.data.get('_deletedBy', null)))
    // _restoredAt lo scrive solo il ripristino da backup (functions/backup.js,
    // Admin SDK) e fa saltare il registro modifiche a auditTrail: il client
    // può solo conservarlo o toglierlo, mai impostarlo o cambiarlo.
    && (d.get('_restoredAt', null) == null
          || (resource != null && d.get('_restoredAt', null) == resource.data.get('_restoredAt', null))
          || isSuperAdmin())
    // allegati: controllati solo se cambiano (ogni elemento costa espressioni)
    && (resource == null ? validAllegati(d.get('allegati', null))
          : (d.get('allegati', null) == resource.data.get('allegati', null)
              || validAllegatiAgg(d.get('allegati', null))))
    // color: controllato solo se cambia (un valore già salvato non blocca altri salvataggi)
    && (isColor(d.get('color', null))
          || (resource != null && d.get('color', null) == resource.data.get('color', null)))
    && importiOk(d)
    && isList(d.get('split', null))
    && isList(d.get('argomenti', null)) && isList(d.get('decisioni', null))
    && isList(d.get('storicoAggiornamenti', null))
    && isText(d.get('titolo', null)) && isText(d.get('nome', null)) && isText(d.get('testo', null))
    && isText(d.get('descrizione', null)) && isText(d.get('note', null)) && dataRecordOk(d)
    && isText(d.get('descrizioneSintetica', null));
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Modello ATTUALE (transitorio) ──────────────────────────
    // Lista CHIUSA di chiavi: una chiave non elencata qui sotto (es. i
    // residui del vecchio login cm_passwords/cm_reset_tokens, rimasti in
    // produzione) non è né leggibile né scrivibile da nessuno, superAdmin
    // compreso. Prima di questo hardening il ramo "else" era isSignedIn(),
    // quindi qualunque chiave sconosciuta era leggibile da ogni condomino.
    match /appdata/{key} {
      // SEC-03: i dati finanziari (blob unico per tutti gli edifici) sono leggibili
      // direttamente dal client solo dal superAdmin. Chiunque altro (member o
      // adminEdificio) li ottiene filtrati per il proprio edificio tramite la
      // Cloud Function getBuildingData (Admin SDK, bypassa queste rules).
      // cm_delibere si aggiunge a questo gruppo: budget e responsabile sono
      // dati sensibili quanto spese/entrate, stesso trattamento. Anche
      // cm_bacheca/cm_verbali/cm_lavori: arrivano già filtrati da
      // getBuildingData, la lettura diretta esponeva quelli degli altri edifici.
      // Audit 2026-09: cm_condomini aggiunto al gruppo superAdmin-only. Il
      // login non cerca più il profilo nel blob (esponeva nomi/email di tutti
      // gli edifici) ma tramite la Cloud Function whoami; i non-superAdmin
      // ottengono i condomini del proprio edificio via getBuildingData.
      // QA 2026-10: cm_login_stats (nomi e orari di accesso di tutti gli
      // edifici) e cm_config (email del superAdmin) passano al gruppo
      // superAdmin-only: il registro lo scrive la Cloud Function whoami e lo
      // mostra solo il superAdmin; cm_config serve solo a whoami (Admin SDK).
      // Audit 2026-10-15: anche cm_edifici (copia della migrazione con i dati
      // di tutti i condomìni): l'app legge l'elenco edifici da buildings/**.
      allow read: if key in ['cm_spese', 'cm_entrate', 'cm_fornitori', 'cm_delibere',
                             'cm_bacheca', 'cm_verbali', 'cm_lavori', 'cm_condomini',
                             'cm_login_stats', 'cm_config', 'cm_edifici']
                   ? isSuperAdmin()
                   : (isSignedIn() && key in ['cm_categorie', 'cm_edificio_attivo', 'cm_branding']);
      // P0 urgente: le chiavi per edificio (spese/entrate/fornitori/condomini/
      // bacheca/verbali/lavori/delibere) sono negate in scrittura diretta a
      // chiunque non sia superAdmin — un adminEdificio/editor che scriveva qui
      // sovrascriveva l'intero blob con SOLO il proprio edificio, cancellando
      // gli altri. Passano dalla Cloud Function saveBuildingData (Admin SDK,
      // fonde solo la propria fetta, bypassa queste rules).
      // cm_edifici/cm_categorie/cm_edificio_attivo/cm_config: in UI li
      // gestisce solo il superAdmin, ora anche lato server.
      // cm_login_stats: lo aggiorna whoami a ogni accesso; il superAdmin può
      // ancora scriverlo direttamente solo per il ripristino da backup.
      // Fase 2 (REB-01): i dati per edificio e l'elenco edifici vivono in
      // buildings/**; le vecchie chiavi (cm_spese … cm_delibere, cm_condomini,
      // cm_edifici) restano in SOLA LETTURA per il superAdmin, come copia di
      // sicurezza della migrazione. Un client vecchio che prova a salvarci
      // riceve un errore invece di scrivere dati che nessuno vedrebbe più.
      allow write: if isSuperAdmin() && key in ['cm_categorie', 'cm_edificio_attivo', 'cm_config', 'cm_branding',
                                                'cm_login_stats'];
    }

    // Specchio dei custom claims, leggibile per debug/UI, scrivibile
    // MAI dal client — solo dalla Cloud Function setUserRole (Admin SDK).
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // Errori dell'app segnalati dai browser (fase 3): ogni utente autenticato
    // può solo AGGIUNGERE segnalazioni a proprio nome, con campi e lunghezze
    // limitati; le legge e cancella solo il superAdmin. dailyBackup elimina
    // quelle più vecchie di 30 giorni.
    match /clientErrors/{id} {
      allow read, delete: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['message', 'stack', 'page', 'uid', 'role', 'buildingId', 'ua', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.get('stack', '') is string && request.resource.data.get('stack', '').size() <= 2000
        && request.resource.data.get('page', '') is string && request.resource.data.get('page', '').size() <= 40
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 200
        && (request.resource.data.get('role', null) == null
            || (request.resource.data.get('role', null) is string && request.resource.data.get('role', null).size() <= 40))
        && (request.resource.data.get('buildingId', null) == null
            || (request.resource.data.get('buildingId', null) is string && request.resource.data.get('buildingId', null).size() <= 64))
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128;
      allow update: if false;
    }

    // Audit trail: append-only, scritto solo da Cloud Functions.
    match /auditEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ─── Modello per edificio (REB-01, fase 2 QA) ───────────────────
    // Un documento per record: buildings/{buildingId}/{collezione}/{id}.
    // Le regole applicano direttamente ruolo ed edificio a ogni record
    // (prima serviva la Cloud Function saveBuildingData, perché le regole
    // non possono leggere dentro il blob JSON condiviso).
    //
    // Ogni scrittura dal client deve:
    // - avere id ed edificioId coerenti con il percorso;
    // - firmare _updatedBy (= chi scrive) e _updatedAt (= ora del server):
    //   la Cloud Function auditTrail ne ricava il registro delle modifiche;
    // - rispettare la forma minima dei campi (elenchi e testi: la pagina li riporta
    //   alla stessa forma in RECORD_SCHEMA, js/core/dati.js).
    // Le cancellazioni sono logiche (_deleted: true, con _deletedBy): così
    // l'audit sa chi ha cancellato cosa e il record è recuperabile. La
    // cancellazione fisica resta al superAdmin.
    match /buildings/{buildingId} {
      // Mai in list per i non-superAdmin: il client deve sempre fare getDoc
      // sul proprio edificio, mai getDocs(collection(...)), tranne il superAdmin.
      allow read: if inBuilding(buildingId);
      allow write: if isSuperAdmin();

      // Condomini: solo adminEdificio/superAdmin. Un adminEdificio non può
      // impostare il flag superAdmin né cambiare l'account collegato (uid):
      // stessa protezione che saveBuildingData applicava al blob.
      // Privacy (decisione del 2026-10-15): tutto il condominio legge nomi,
      // appartamenti e quote, ma email e telefono non stanno qui (le regole
      // non nascondono singoli campi): sono in contatti/, più sotto.
      match /members/{docId} {
        allow read: if inBuilding(buildingId);
        allow create, update: if canAdmin(buildingId) && validRecord(buildingId, docId)
          && !request.resource.data.keys().hasAny(['email', 'emailLower', 'telefono'])
          // DAT-008: rappresentante è un booleano (un testo come "false" conterrebbe vero nel
          // codice) e le date hanno la forma attesa; controlli solo se il valore cambia.
          && (request.resource.data.get('rappresentante', false) is bool
              || (resource != null && request.resource.data.get('rappresentante', null) == resource.data.get('rappresentante', null)))
          && dataOk(request.resource.data, 'dataIngresso') && dataOk(request.resource.data, 'dataUscita')
          && (isSuperAdmin() || (
                request.resource.data.get('superAdmin', false) == (resource == null ? false : resource.data.get('superAdmin', false))
             && request.resource.data.get('uid', null) == (resource == null ? null : resource.data.get('uid', null))))
          // Audit 2026-10-30: un amministratore non cambia sul proprio record (quello collegato al suo
          // account) ciò che gli dà o gli toglie i permessi: disattivazione, cancellazione, data di
          // uscita, ruolo. Altrimenti, revocato con un token ancora valido, si riattivava da solo e
          // whoami gli ridava il ruolo. Il resto del proprio profilo (nome, colore…) resta modificabile.
          && (isSuperAdmin() || resource == null || resource.data.get('uid', null) != request.auth.uid
              || (request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
                  && request.resource.data.get('_deleted', false) == resource.data.get('_deleted', false)
                  && request.resource.data.get('dataUscita', null) == resource.data.get('dataUscita', null)
                  && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                  && request.resource.data.get('canEdit', false) == resource.data.get('canEdit', false)));
        allow delete: if isSuperAdmin();
      }

      // Contatti dei condomini (email, telefono), stesso id del condomino: li
      // leggono solo amministratori ed editor del condominio, li scrive
      // l'amministratore (js/core/dati.js). emailLower serve a whoami per
      // riconoscere chi accede e deve coincidere con l'email.
      match /contatti/{docId} {
        allow read: if canEdit(buildingId);
        allow create, update: if canAdmin(buildingId) && validRecord(buildingId, docId)
          && request.resource.data.keys().hasOnly(['id', 'edificioId', 'email', 'emailLower', 'telefono',
               '_createdBy', '_createdAt', '_updatedBy', '_updatedAt', '_deleted', '_deletedBy', '_restoredAt'])
          && (request.resource.data.get('email', null) == null
              ? request.resource.data.get('emailLower', null) == null
              : (request.resource.data.email is string && request.resource.data.email.size() <= 200
                 && request.resource.data.get('emailLower', null) == request.resource.data.email.lower()))
          && (request.resource.data.get('telefono', null) == null
              || (request.resource.data.telefono is string && request.resource.data.telefono.size() <= 40));
        allow delete: if isSuperAdmin();
      }

      // Storico delle email (functions/notifiche.js): lo scrive solo il server,
      // lo leggono gli amministratori del condominio.
      match /invii/{docId} {
        allow read: if canAdmin(buildingId);
        allow write: if false;
      }

      // Messaggi WhatsApp aperti dall'app (js/sezioni/whatsapp.js): l'invio lo fa
      // l'amministratore dal suo telefono, qui resta a chi è stato aperto. Lo
      // scrive l'amministratore (una voce per scheda, che si allunga), nessuno
      // lo cancella.
      match /inviiWhatsapp/{docId} {
        allow read: if canAdmin(buildingId);
        allow create: if canAdmin(buildingId)
          && request.resource.data.keys().hasOnly(['evento', 'titolo', 'aperti', 'autoreUid', 'creatoIl', 'aggiornatoIl'])
          && request.resource.data.evento in ['rendiconto', 'avviso', 'verbale', 'promemoria']
          && request.resource.data.titolo is string && request.resource.data.titolo.size() <= 200
          && request.resource.data.aperti is list && request.resource.data.aperti.size() <= 300
          && request.resource.data.autoreUid == request.auth.uid
          && request.resource.data.creatoIl == request.time
          && request.resource.data.aggiornatoIl == request.time;
        allow update: if canAdmin(buildingId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aperti', 'aggiornatoIl'])
          && request.resource.data.aperti is list && request.resource.data.aperti.size() <= 300
          && request.resource.data.aggiornatoIl == request.time;
        allow delete: if false;
      }

      // Impostazioni del condominio, modificabili solo dagli amministratori:
      //  - email: promemoria automatici delle rate (letti solo dagli amministratori);
      //  - whatsapp: testi dei messaggi, firma ed eventi spenti (solo amministratori);
      //  - millesimi: tabelle millesimali (lette da tutto il condominio, per l'anagrafica);
      //  - affitti: appartamenti in affitto (letti da tutto il condominio, per l'estratto conto).
      match /impostazioni/{docId} {
        allow read: if canAdmin(buildingId) || (docId in ['millesimi', 'affitti'] && inBuilding(buildingId));
        allow create, update: if canAdmin(buildingId)
          && request.resource.data.aggiornatoDa == request.auth.uid
          && request.resource.data.aggiornatoIl == request.time
          && ((docId == 'email'
                && request.resource.data.keys().hasOnly(['promemoriaAuto', 'giorniPreavviso', 'aggiornatoDa', 'aggiornatoIl'])
                && request.resource.data.promemoriaAuto is bool
                && request.resource.data.giorniPreavviso is int
                && request.resource.data.giorniPreavviso >= 1 && request.resource.data.giorniPreavviso <= 15)
            || (docId == 'whatsapp'
                && request.resource.data.keys().hasOnly(['modelli', 'firma', 'eventiSpenti', 'aggiornatoDa', 'aggiornatoIl'])
                && request.resource.data.modelli is map
                && request.resource.data.modelli.keys().hasOnly(['rendiconto', 'avviso', 'verbale', 'promemoria'])
                && testoWa(request.resource.data.modelli.get('rendiconto', ''))
                && testoWa(request.resource.data.modelli.get('avviso', ''))
                && testoWa(request.resource.data.modelli.get('verbale', ''))
                && testoWa(request.resource.data.modelli.get('promemoria', ''))
                && request.resource.data.firma is string && request.resource.data.firma.size() <= 100
                && request.resource.data.eventiSpenti is list
                && request.resource.data.eventiSpenti.hasOnly(['rendiconto', 'avviso', 'verbale', 'promemoria']))
            || (docId == 'affitti'
                && request.resource.data.keys().hasOnly(['appartamenti', 'aggiornatoDa', 'aggiornatoIl'])
                && request.resource.data.appartamenti is map && request.resource.data.appartamenti.size() <= 300)
            || (docId == 'millesimi'
                && request.resource.data.keys().hasOnly(['attivo', 'dal', 'tabelle', 'categorie', 'aggiornatoDa', 'aggiornatoIl'])
                && request.resource.data.attivo is bool
                && request.resource.data.dal is string && request.resource.data.dal.size() <= 10
                && request.resource.data.tabelle is list && request.resource.data.tabelle.size() <= 20
                && request.resource.data.categorie is map));
        allow delete: if false;
      }

      // Dati finanziari: anche 'editor' nel proprio edificio.
      match /{coll}/{docId} {
        allow read: if inBuilding(buildingId)
          && coll in ['expenses', 'payments', 'suppliers', 'notices', 'minutes', 'works', 'resolutions'];
        allow create, update: if validRecord(buildingId, docId) && (
             (coll in ['expenses', 'payments', 'suppliers'] && canEdit(buildingId))
          || (coll in ['notices', 'minutes', 'works', 'resolutions'] && canAdmin(buildingId)));
        allow delete: if isSuperAdmin()
          && coll in ['expenses', 'payments', 'suppliers', 'notices', 'minutes', 'works', 'resolutions'];
      }
    }

    // Profilo whoami/bootstrap: ognuno legge/scrive solo il proprio.
    // Non contiene flag di ruolo autorevoli (quelli sono nel custom claim
    // e nello specchio roles/{uid}, mai scrivibili dal client).
    // Audit 2026-10-24: il codice non usa più questa collezione (whoami e il resto
    // passano dall'Admin SDK): la scrittura resta solo per il proprio profilo,
    // con i soli campi email e displayName, brevi, e senza cancellazione.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName'])
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 200
        && request.resource.data.get('displayName', '') is string && request.resource.data.get('displayName', '').size() <= 200;
      allow read: if isSuperAdmin();
    }

    // Impostazioni globali: stato dei backup e dei controlli del servizio
    // (functions/backup.js, controllo.js), mostrati solo al superAdmin in
    // Stato del servizio. Audit 2026-10-19: prima le leggeva chiunque fosse
    // autenticato, con nomi dei file ed errori interni.
    match /appSettings/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Tracciamento del backfill: mai accessibile dal client, solo dagli
    // script Admin SDK che bypassano le rules.
    match /migrationJobs/{jobId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Default deny esplicito — nessun path non elencato è accessibile.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
