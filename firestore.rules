rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  NERI DA RIMINI — Firestore Security Rules
//  FASE 1 (contenimento) — lavora sopra il modello dati ATTUALE
//  (appdata/{key} con blob JSON) senza romperlo.
//
//  ATTENZIONE — LIMITE STRUTTURALE ONESTO:
//  Il modello "appdata" impacchetta TUTTI gli edifici in un unico
//  campo stringa JSON per chiave (es. appdata/cm_spese).
//  Le Security Rules non possono fare parsing del contenuto di un
//  campo per applicare un controllo per-record (per-edificio).
//  Quindi qui NON si ottiene isolamento multi-tenant reale sui dati
//  economici — quello richiede la migrazione allo schema
//  normalizzato "buildings/**" (in fondo a questo file, già pronto
//  e testato, disattivo finché REB-01 non è completata) oppure il
//  passaggio attraverso la Cloud Function `getBuildingData` come
//  ponte transitorio (vedi functions/index.js).
//
//  Quello che QUESTA fase chiude davvero:
//  - accesso non autenticato → sempre negato
//  - scrittura di appdata/cm_config (identità del superAdmin) →
//    solo chi ha già il custom claim role=='superAdmin'
//  - scrittura di appdata/cm_condomini (dove oggi si promuove un
//    ruolo, riga ~5306 di index.html) → solo ruoli admin, mai un
//    condomino semplice
//  - qualunque scrittura diretta dal client sulla collection
//    `roles/*` → SEMPRE negata (la scrivono solo le Cloud
//    Functions con Admin SDK, che bypassano le rules)
//
//  SINCRONIZZAZIONE CHIAVI appdata — questo file resta l'UNICA eccezione
//  sincronizzata a mano: functions/index.js (APPDATA_RESTRICTED_CONFIG) e
//  index.html (APPDATA_CONFIG) derivano le proprie liste da un unico
//  oggetto di configurazione JS per runtime — qui non è possibile, perché
//  le Security Rules sono un linguaggio dichiarativo che non può
//  importare quell'oggetto. Aggiungere o togliere una chiave "ristretta"
//  richiede di aggiornare a mano, in coppia: gli elenchi di lettura e
//  scrittura di match /appdata/{key} qui sotto (lista chiusa: una chiave
//  nuova non elencata è negata a tutti), APPDATA_RESTRICTED_CONFIG in
//  functions/index.js, e APPDATA_CONFIG in index.html.
// ═══════════════════════════════════════════════════════════════

function isSignedIn() {
  return request.auth != null;
}

function role() {
  return request.auth.token.role; // 'superAdmin' | 'adminEdificio' | 'editor' | 'member' | null
}

function isSuperAdmin() {
  return isSignedIn() && role() == 'superAdmin';
}

function isBuildingAdmin() {
  return isSignedIn() && (role() == 'superAdmin' || role() == 'adminEdificio');
}

// REB-01 P1: 'editor' può scrivere i dati finanziari (spese/entrate/
// fornitori) del proprio edificio ma non gestire condomini/edificio —
// a differenza di 'member' che oggi è di sola lettura in UI. Introdotto
// perché il blocco buildings/** sotto, a differenza delle regole interim
// di appdata/{key}, non concede scritture a 'member' di default.
function isEditor() {
  return isSignedIn() && (role() == 'superAdmin' || role() == 'adminEdificio' || role() == 'editor');
}

function myBuildingId() {
  return request.auth.token.buildingId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Modello ATTUALE (transitorio) ──────────────────────────
    // Lista CHIUSA di chiavi: una chiave non elencata qui sotto (es. i
    // residui del vecchio login cm_passwords/cm_reset_tokens, rimasti in
    // produzione) non è né leggibile né scrivibile da nessuno, superAdmin
    // compreso. Prima di questo hardening il ramo "else" era isSignedIn(),
    // quindi qualunque chiave sconosciuta era leggibile da ogni condomino.
    match /appdata/{key} {
      // SEC-03: i dati finanziari (blob unico per tutti gli edifici) sono leggibili
      // direttamente dal client solo dal superAdmin. Chiunque altro (member o
      // adminEdificio) li ottiene filtrati per il proprio edificio tramite la
      // Cloud Function getBuildingData (Admin SDK, bypassa queste rules).
      // cm_delibere si aggiunge a questo gruppo: budget e responsabile sono
      // dati sensibili quanto spese/entrate, stesso trattamento. Anche
      // cm_bacheca/cm_verbali/cm_lavori: arrivano già filtrati da
      // getBuildingData, la lettura diretta esponeva quelli degli altri edifici.
      // Audit 2026-09: cm_condomini aggiunto al gruppo superAdmin-only. Il
      // login non cerca più il profilo nel blob (esponeva nomi/email di tutti
      // gli edifici) ma tramite la Cloud Function whoami; i non-superAdmin
      // ottengono i condomini del proprio edificio via getBuildingData.
      allow read: if key in ['cm_spese', 'cm_entrate', 'cm_fornitori', 'cm_delibere',
                             'cm_bacheca', 'cm_verbali', 'cm_lavori', 'cm_condomini']
                   ? isSuperAdmin()
                   : (isSignedIn() && key in ['cm_edifici', 'cm_categorie',
                                              'cm_edificio_attivo', 'cm_login_stats', 'cm_config']);
      // P0 urgente: le chiavi per edificio (spese/entrate/fornitori/condomini/
      // bacheca/verbali/lavori/delibere) sono negate in scrittura diretta a
      // chiunque non sia superAdmin — un adminEdificio/editor che scriveva qui
      // sovrascriveva l'intero blob con SOLO il proprio edificio, cancellando
      // gli altri. Passano dalla Cloud Function saveBuildingData (Admin SDK,
      // fonde solo la propria fetta, bypassa queste rules).
      // cm_edifici/cm_categorie/cm_edificio_attivo/cm_config: in UI li
      // gestisce solo il superAdmin, ora anche lato server.
      // cm_login_stats resta scrivibile da chiunque sia autenticato: ogni
      // login aggiorna il contatore (registraLogin in index.html).
      allow write: if key == 'cm_login_stats'
                   ? isSignedIn()
                   : (isSuperAdmin() && key in ['cm_spese', 'cm_entrate', 'cm_fornitori', 'cm_condomini',
                                                'cm_bacheca', 'cm_verbali', 'cm_lavori', 'cm_delibere',
                                                'cm_edifici', 'cm_categorie', 'cm_edificio_attivo', 'cm_config']);
    }

    // Specchio dei custom claims, leggibile per debug/UI, scrivibile
    // MAI dal client — solo dalla Cloud Function setUserRole (Admin SDK).
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // Audit trail: append-only, scritto solo da Cloud Functions.
    match /auditEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ─── Schema NORMALIZZATO target (REB-01) — pronto, non ancora
    //     in uso finché la migrazione dati non è completata ────
    match /buildings/{buildingId} {
      // Mai in list per i non-superAdmin: una query su tutta la collection
      // buildings fallirebbe in blocco per loro (stesso comportamento già
      // visto su appdata quando le regole non sono uniformi per ogni
      // documento) — il client deve sempre fare getDoc sul proprio id,
      // mai getDocs(collection(...)), tranne che da superAdmin.
      allow read: if isSignedIn() && (isSuperAdmin() || myBuildingId() == buildingId);
      allow write: if isSuperAdmin();

      // Gestione condomini/membri: riservata ad adminEdificio/superAdmin,
      // mai a 'editor' o 'member' — stessa politica di cm_condomini oggi.
      // Blocco separato ed esclusivo (non un wildcard generico): in
      // Firestore i match che si sovrappongono sulla stessa collection si
      // sommano (OR), quindi un wildcard "tutte le sottocollection" qui
      // accanto lascerebbe scrivere anche i condomini a un 'editor'.
      match /members/{memberId} {
        allow read: if isSignedIn() && (isSuperAdmin() || myBuildingId() == buildingId);
        allow write: if isSuperAdmin()
                     || (isBuildingAdmin() && myBuildingId() == buildingId);
      }

      // Dati finanziari: anche 'editor' può scriverli nel proprio edificio.
      // Tre blocchi identici ed espliciti invece di un wildcard, per lo
      // stesso motivo di sopra — mai un pattern che includa anche members.
      match /expenses/{docId} {
        allow read: if isSignedIn() && (isSuperAdmin() || myBuildingId() == buildingId);
        allow write: if isSuperAdmin() || (isEditor() && myBuildingId() == buildingId);
      }
      match /payments/{docId} {
        allow read: if isSignedIn() && (isSuperAdmin() || myBuildingId() == buildingId);
        allow write: if isSuperAdmin() || (isEditor() && myBuildingId() == buildingId);
      }
      match /suppliers/{docId} {
        allow read: if isSignedIn() && (isSuperAdmin() || myBuildingId() == buildingId);
        allow write: if isSuperAdmin() || (isEditor() && myBuildingId() == buildingId);
      }
    }

    // Profilo whoami/bootstrap: ognuno legge/scrive solo il proprio.
    // Non contiene flag di ruolo autorevoli (quelli sono nel custom claim
    // e nello specchio roles/{uid}, mai scrivibili dal client).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    // Impostazioni globali (categorie condivise, feature flag di
    // migrazione, residuo di cm_config): leggibili da chiunque sia
    // autenticato, scrivibili solo dal superAdmin.
    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Tracciamento del backfill: mai accessibile dal client, solo dagli
    // script Admin SDK che bypassano le rules.
    match /migrationJobs/{jobId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Default deny esplicito — nessun path non elencato è accessibile.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
